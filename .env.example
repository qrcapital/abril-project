# Estratégia Internacional — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commitar .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SÓ no servidor, ignora RLS. Nunca prefixar com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Checkout Guru (pendência: secret + docs do payload) ---
GURU_WEBHOOK_SECRET=
NEXT_PUBLIC_CHECKOUT_URL=

# --- Panda Video (pendência: API key) ---
PANDA_API_KEY=

# --- Envio de e-mail (Resend, em uso desde 31/jul/2026) ---
# É o provedor dos transacionais nossos (lib/email.ts). O mesmo Resend que já é o SMTP dos
# e-mails do Supabase Auth desde 28/jul. SEM a chave, o app sobe e as telas funcionam: o envio
# falha e a tentativa fica registrada em email_log com "falha: sem RESEND_API_KEY no ambiente".
RESEND_API_KEY=
# Remetente. Em homolog, `onboarding@resend.dev` é o único validado sem domínio próprio, e é o
# padrão do código quando esta variável está vazia.
EMAIL_FROM=

# --- Amazon SES (pendência: domínio verificado, SPF/DKIM/DMARC) ---
# Previsto para produção, junto com a decisão do domínio. Trocar o provedor é reescrever a
# chamada de `lib/email.ts`: a assinatura SigV4 pede o SDK da AWS, que ainda não é dependência.
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# --- Suporte / marca ---
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/message/W2USYZZK75FMC1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# --- Pré-lista /lista-de-espera ---
# O lead NÃO passa por estas variáveis: quem grava é o RD Station, pela captura automática de
# Leads, com o código de monitoramento no <body> das rotas da pré-lista (app/lista-de-espera/
# Tela.tsx). Não há token a configurar. Detalhe da decisão em docs/PENDENCIAS-LP.md.
#
# Política de privacidade da Abril. Vazio: o trecho "Política de Privacidade · LGPD" do aviso
# de aceite sai sem link, que é melhor que um link morto — mas não é publicável, porque a tela
# coleta dado pessoal e o consentimento é o próprio envio.
NEXT_PUBLIC_POLITICA_PRIVACIDADE_URL=
# Destino do redirect pós-inscrição. Vazio: o card de confirmação assume no lugar do
# formulário, sem redirect (é o fallback do design). Para usar a nossa: /lista-de-espera/obrigado
NEXT_PUBLIC_LISTA_ESPERA_OBRIGADO_URL=
# Rede de proteção do POST /api/lista-de-espera, hoje sem uso: sem esta chave a rota valida o
# lead e registra no log, sem enviar. Ela só passa a valer se um dia trocarmos a captura
# automática pela API de conversões (e aí o identificador do campo `cf_` vem do painel do RD).
RD_STATION_API_KEY=
