# Estratégia Internacional — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commitar .env.local.

# --- Ambiente ---
# Sem esta variável o app se comporta como PRODUÇÃO (fail-closed desde 29/set/2026): cadastro
# fechado e webhook do Guru exigindo token. Valores de teste: local, development, homolog.
NEXT_PUBLIC_APP_ENV=local
# Abre o cadastro livre da tela de login num ambiente que seria produção. Só servidor. Valor: sim.
CADASTRO_ABERTO=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SÓ no servidor, ignora RLS. Nunca prefixar com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Checkout Guru (webhook em /api/webhooks/guru) ---
# Account Token do Guru (Configurações > API). Vem no corpo de cada webhook e é conferido aqui.
# Em produção, vazio = toda entrega recusada com 503.
GURU_API_TOKEN=
# Nome antigo do mesmo token, aceito só quando GURU_API_TOKEN está vazio. Prefira o de cima.
GURU_WEBHOOK_SECRET=
# IDs do produto e/ou da oferta no Guru, separados por vírgula. Vazio = aceita qualquer produto.
GURU_PRODUCT_IDS=
# Link do checkout do Guru, destino do botão "GARANTIR MINHA VAGA" da LP. Só https://.
NEXT_PUBLIC_CHECKOUT_URL=

# --- Panda Video (pendência: API key) ---
PANDA_API_KEY=

# --- Envio de e-mail (lib/email.ts) ---
# Provedor: ses ou resend. Vazio = SES se as duas chaves do SES existem, senão Resend se houver
# RESEND_API_KEY. Sem nenhum, o envio falha e o motivo fica no email_log.
EMAIL_PROVIDER=
# Remetente. Padrão: Estratégia Internacional <contato@blocktrends.com.br> (domínio verificado no SES).
EMAIL_FROM=
# Para onde vai a resposta do aluno. Padrão: contato@blocktrends.com.br.
EMAIL_REPLY_TO=

# --- Amazon SES (provedor de produção) ---
# SEM o prefixo AWS_: a Netlify reserva AWS_ACCESS_KEY_ID e companhia para o próprio runtime.
# Região do SES. Padrão: sa-east-1.
SES_REGION=sa-east-1
# Chave do usuário IAM que só pode ses:SendEmail e ses:SendRawEmail.
SES_ACCESS_KEY_ID=
# Segredo da mesma chave. Só no painel da Netlify, contexto de produção.
SES_SECRET_ACCESS_KEY=
# Configuration set do SES (ex.: estrategia-transacional). Com ele, o SES publica os eventos de
# entrega no tópico SNS que chama /api/webhooks/ses. Opcional. Passo a passo: docs/SES-RASTREIO.md.
SES_CONFIGURATION_SET=
# ARN do tópico SNS que recebe os eventos do configuration set. A rota /api/webhooks/ses só aceita
# mensagens deste tópico, e sem a variável responde 503 a tudo.
SES_SNS_TOPIC_ARN=

# --- Resend (reserva, e o provedor validado em homolog) ---
# Com EMAIL_FROM vazio, o Resend usa onboarding@resend.dev, o único aceito sem domínio próprio.
RESEND_API_KEY=

# --- Suporte / marca ---
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/message/W2USYZZK75FMC1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# --- Pré-lista /lista-de-espera ---
# Não há variável para o envio do lead: quem grava é o RD Station, pela captura automática de
# Leads, com o código de monitoramento no <body> da rota (app/lista-de-espera/Tela.tsx).
# A confirmação acontece no próprio card, sem redirect. Detalhe em docs/PENDENCIAS-LP.md.
#
# Política de privacidade da Abril. Vazio: o trecho "Política de Privacidade · LGPD" do aviso
# de aceite sai sem link, que é melhor que um link morto. Dispensável em homolog; necessária
# antes de divulgar, porque a tela coleta dado pessoal e o consentimento é o próprio envio.
NEXT_PUBLIC_POLITICA_PRIVACIDADE_URL=

# --- Documentos e log de consentimento (migration 0023) ---
# Termos de Uso. Mesma regra da política acima: vazio, o nome aparece na caixa de aceite sem link.
# As DUAS precisam estar preenchidas antes de abrir as vendas: a tela de primeiro acesso pede o
# aceite dos dois documentos, e aceitar um texto que não abre é consentimento sem informação.
NEXT_PUBLIC_TERMOS_USO_URL=
#
# Não há variável para a versão vigente dos documentos: ela mora na tabela `consent_documents`,
# semeada pela 0023 com a revisão de 28/set/2026. Publicar uma revisão é inserir uma linha nova
# lá, sem deploy, e as telas voltam a pedir o aceite sozinhas.
