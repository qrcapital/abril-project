# Estratégia Internacional — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commitar .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SÓ no servidor, ignora RLS. Nunca prefixar com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Checkout Guru (pendência: secret + docs do payload) ---
GURU_WEBHOOK_SECRET=
NEXT_PUBLIC_CHECKOUT_URL=

# --- Panda Video (pendência: API key) ---
PANDA_API_KEY=

# --- Amazon SES (pendência: domínio verificado, SPF/DKIM/DMARC) ---
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# --- Suporte / marca ---
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/message/W2USYZZK75FMC1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
